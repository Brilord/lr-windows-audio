<Window x:Class="BalanceDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BalanceDock"
        Height="620"
        Width="460"
        MinHeight="520"
        MinWidth="420"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing"
        StateChanged="OnStateChanged">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#26313B" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#3A4652" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Minimum" Value="-100" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="TickFrequency" Value="5" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <DockPanel LastChildFill="True">
                <TextBlock Text="BalanceDock"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Retry"
                            Margin="0,0,8,0"
                            Click="OnRetryClicked" />
                    <Button Content="Reset"
                            Margin="0,0,8,0"
                            Click="OnResetClicked" />
                    <Button Content="Exit"
                            Click="OnExitClicked" />
                </StackPanel>
            </DockPanel>

            <Border Margin="0,16,0,0"
                    Padding="12"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#26313B"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Active output"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontSize="12" />
                    <TextBlock x:Name="DeviceNameText"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ModeText"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,22,0,0">
                <Grid>
                    <TextBlock Text="L"
                               HorizontalAlignment="Left"
                               Foreground="{StaticResource SubtleTextBrush}" />
                    <TextBlock Text="Center"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}" />
                    <TextBlock Text="R"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource SubtleTextBrush}" />
                </Grid>
                <Slider x:Name="BalanceSlider"
                        Margin="0,10,0,0"
                        Height="44"
                        ValueChanged="OnBalanceSliderChanged" />
            </StackPanel>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LeftPercentText"
                           Grid.Column="0"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="RightPercentText"
                           Grid.Column="1"
                           HorizontalAlignment="Right"
                           FontSize="24"
                           FontWeight="SemiBold" />
            </Grid>

            <TextBlock x:Name="StatusText"
                       Margin="0,14,0,0"
                       Foreground="{StaticResource SubtleTextBrush}"
                       TextWrapping="Wrap"
                       FontSize="12" />

            <Border Margin="0,18,0,0"
                    Padding="12"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#26313B"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Device Info"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DeviceInfoText"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource SubtleTextBrush}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0"
                    Padding="12"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="#26313B"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Hotkeys"
                               FontSize="15"
                               FontWeight="SemiBold" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Left" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            <ComboBox x:Name="LeftHotkeyComboBox" SelectionChanged="OnHotkeySettingChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Right" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            <ComboBox x:Name="RightHotkeyComboBox" SelectionChanged="OnHotkeySettingChanged" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Reset" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            <ComboBox x:Name="ResetHotkeyComboBox" SelectionChanged="OnHotkeySettingChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Step" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            <ComboBox x:Name="StepComboBox" SelectionChanged="OnHotkeySettingChanged">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="5" />
                                <ComboBoxItem Content="10" />
                                <ComboBoxItem Content="25" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ResetOnExitCheckBox"
                              Content="Reset to center when exiting BalanceDock"
                              Checked="OnResetOnExitChanged"
                              Unchecked="OnResetOnExitChanged" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="LogPathText"
                       Margin="0,12,0,0"
                       Foreground="{StaticResource SubtleTextBrush}"
                       TextWrapping="Wrap"
                       FontSize="11" />
        </StackPanel>
    </ScrollViewer>
</Window>
